# Base de datos (contenedor Postgres local, o el DSN del VPS en producción)
DATABASE_URL=postgresql://geifem:geifem@localhost:5432/geifem_agentes
TEST_DATABASE_URL=postgresql://geifem:geifem@localhost:5432/geifem_agentes_test

# Anthropic — VERIFY: confirmar el id de modelo vigente vía la skill claude-api antes de usar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=

# Autoriza GET /api/cron/dian-sync y POST /api/cron/weekly-report — openssl rand -hex 16
CRON_SECRET=

# Resend (correo)
RESEND_API_KEY=

# WhatsApp Business Cloud API — VERIFY: confirmar versión vigente de Graph API antes de usar
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cifrado de credenciales de Alegra por tenant (AES-256-GCM) — openssl rand -hex 32
ENCRYPTION_KEY=

# Puerto de la app (compose)
PORT=3000
